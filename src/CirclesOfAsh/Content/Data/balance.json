{
  // Drei Verliese je Kreis: zwei Wellen-Verliese und der Thronsaal. Bei neun Kreisen
  // sind das 27 Verliese - ein Abstieg bleibt damit an einem Abend schaffbar.
  // ACHTUNG: prison.dungeonIndex in worlds.json muss kleiner sein als dieser Wert - 1.
  "dungeonsPerCircle": 3,
  "difficultyStepPerDungeon": 0.35,
  "baseRoomCount": 5,
  "roomsPerDungeonIndex": 1,
  "treasureBranches": 2,
  "baseWavesPerArena": 2,
  "baseWaveSize": 8,
  "waveGrowth": 0.35,
  "spawnInterval": 0.3,
  "maxAliveEnemies": 22,
  "waveBreakSeconds": 2,
  "xpBase": 5,
  "xpGrowth": 1.25,
  "upgradeChoices": 3,
  "companionSlots": 1,
  "believerRetentionOnDeath": 0.25,
  "mightPerHundredBelievers": 0.05,
  "healthPerHundredBelievers": 0.05,
  "heartDropChance": 0.04,
  "manaDropChance": 0.06,
  "maxActiveMissions": 3,
  "chestsPerDungeon": 1,
  "leverCount": 3,
  "maxDetours": 2,
  "crumbleDelay": 0.45,
  "crumbleRespawnSeconds": 4,
  "brazierTimeLimit": 14,
  // Wie die Raetsel mit der Tiefe anziehen. Jeder Wert ist "Startwert + Zuwachs * Kreisindex",
  // geklemmt auf das Maximum bzw. Minimum. Kreis 0 = Limbus, Kreis 8 = Verrat.
  // Die Schiebebloecke ergeben sich aus den Platten: immer genau einer weniger.
  "puzzleScaling": {
    // runeOrderLength waechst nicht mit: runes.png hat genau vier Symbole.
    "runeOrderLength": 4,
    "brazierTimeLossPerCircle": 0.5,
    "brazierTimeLimitMin": 9,
    "leverCountPerCircle": 0,
    "leverCountMax": 5,
    "weightPlates": 3,
    "weightPlatesMax": 4,
    "weightPlatesPerCircle": 0.2
  },
  "ambientLift": 0.32,
  "defaultScreenScale": 3,
  // Deko-Regler: 1 = Mengen wie in themes.json, kleiner = leerere Räume.
  "decorDensity": 0.6,
  // Glutschmiede im Tempel. Flicken kostet forgeMendCost + forgeCostPerUse * bisherige Nutzungen
  // im selben Lauf - Reparieren soll eine Entscheidung bleiben, keine Gewohnheit. Neu weben gibt
  // es nur, wenn gar nichts mehr getragen wird, und kommt zerfetzt heraus.
  "forgeMendCost": 8,
  "forgeCostPerUse": 6,
  "forgeWeaveCost": 25,
  "forgeMendHits": 1,
  // Arena zu zweit: so viel mehr Leben je weiterer Spielfigur (0.6 = +60 %). Nicht +100 %:
  // Zwei Spieler stehen sich auch im Weg, und Aufrichten kostet Zeit.
  "arenaHealthPerExtraPlayer": 0.6
}
