[
  // Controller-Profile (Content/Data/controllers.json).
  //   match    = Textbausteine, die im Gerätenamen gesucht werden (klein geschrieben, erster Treffer gewinnt).
  //              Leer = Auffangprofil, wenn kein anderes passt.
  //   labels   = Beschriftung je Spielaktion. Der Code kennt nur die Aktion, nie eine Taste.
  // Die Reihenfolge in dieser Datei entscheidet, welches Profil zuerst geprüft wird.
  {
    "id": "dualsense",
    "name": "PlayStation",
    "match": [ "dualsense", "dualshock", "playstation", "ps4", "ps5", "wireless controller" ],
    "labels": {
      "Jump": "X", "Dash": "R1", "AbilityOne": "□", "AbilityTwo": "△",
      "Interact": "L1", "Confirm": "X", "Cancel": "○", "Pause": "Options", "Randomize": "Create",
      "Attack": "R2", "Block": "L2"
    }
  },
  {
    "id": "switch",
    "name": "Nintendo Switch",
    "match": [ "nintendo", "switch", "joy-con", "joycon", "pro controller" ],
    "labels": {
      "Jump": "B", "Dash": "R", "AbilityOne": "Y", "AbilityTwo": "X",
      "Interact": "L", "Confirm": "B", "Cancel": "A", "Pause": "+", "Randomize": "-",
      "Attack": "ZR", "Block": "ZL"
    }
  },
  {
    "id": "steam",
    "name": "Steam Deck",
    "match": [ "steam" ],
    "labels": {
      "Jump": "A", "Dash": "R1", "AbilityOne": "X", "AbilityTwo": "Y",
      "Interact": "L1", "Confirm": "A", "Cancel": "B", "Pause": "Menü", "Randomize": "Ansicht",
      "Attack": "R2", "Block": "L2"
    }
  },
  {
    // 8BitDo-Pads melden sich je nach Modus (Switch/XInput/DInput) unterschiedlich, die
    // Belegung bleibt aber physisch gleich: Nintendo-Layout mit Xbox-Tastennamen.
    "id": "8bitdo",
    "name": "8BitDo",
    "match": [ "8bitdo" ],
    "labels": {
      "Jump": "A", "Dash": "R1", "AbilityOne": "X", "AbilityTwo": "Y",
      "Interact": "L1", "Confirm": "A", "Cancel": "B", "Pause": "Start", "Randomize": "Select"
    }
  },
  {
    // Logitech-Pads (F3xx/F5xx/ChillStream) nutzen das Xbox-Layout, melden sich aber
    // haeufig als reines DirectInput-Geraet ohne "xbox" im Namen.
    "id": "logitech",
    "name": "Logitech",
    "match": [ "logitech" ],
    "labels": {
      "Jump": "1", "Dash": "R1", "AbilityOne": "3", "AbilityTwo": "4",
      "Interact": "L1", "Confirm": "1", "Cancel": "2", "Pause": "9", "Randomize": "10"
    }
  },
  {
    "id": "xbox",
    "name": "Xbox",
    "match": [],
    "labels": {
      "Jump": "A", "Dash": "RB", "AbilityOne": "X", "AbilityTwo": "Y",
      "Interact": "LB", "Confirm": "A", "Cancel": "B", "Pause": "Menü", "Randomize": "Ansicht",
      "Attack": "RT", "Block": "LT"
    }
  }
]
