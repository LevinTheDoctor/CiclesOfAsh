  // Kleidung und Rüstung (Slot Armor): flache Schadensreduktion pro Treffer (StatType.Armor).
  // armorHits = Treffer, die das Stück VOLLSTÄNDIG abfängt, bevor es zerfällt. Unzerstörbar gibt es
  //   nicht: Ohne Angabe wird aus durability abgeleitet, mindestens aber 3 (EquipmentService).
  // sprite = Kleidungs-Ebene über dem Körper. Erwartet werden DREI Verfallsstufen:
  //   "<sprite>" (heil), "<sprite>.worn" (angeschlagen), "<sprite>.broken" (zerfetzt).
  // lootable: false = gehört einer Klasse und taucht nie in Truhen auf.

  // Startkleidung: je Klasse ein eigenes Stück. Drei Treffer, damit man alle drei Stufen sieht,
  // und kaum Schutz – sie ist nur der Anfang, nicht die Belohnung.
  { "id": "crusader_garb", "name": "Kreuzritterkutte", "slot": "Armor", "rarity": "Common",
    "armorHits": 3, "durability": 45, "lootable": false, "sprite": "armor.crusader_garb",
    "description": "Wams, Riemen und Beinzeug des Ordens. Mehr Bekenntnis als Panzer.",
    "modifiers": [ { "stat": "Armor", "amount": 1 } ] },
  { "id": "soot_robe", "name": "Rußrobe", "slot": "Armor", "rarity": "Common",
    "armorHits": 3, "durability": 45, "lootable": false, "sprite": "armor.soot_robe",
    "description": "Schwer vom Rauch der Kerzen. Hält warm, hält nichts ab.",
